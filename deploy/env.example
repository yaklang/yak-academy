# docker compose 环境变量样例：复制为仓库根目录 .env 后按需修改。
# .env 已被 .gitignore 忽略，不会提交密钥。

# 必填：JWT 签名密钥（随机长字符串）
ACADEMY_JWT_SECRET=change-me-to-a-long-random-string

# 必填：初始管理员密码（users 表为空时首次启动创建）
ACADEMY_ADMIN_USERNAME=admin
ACADEMY_ADMIN_PASSWORD=change-me

# 题目容器检测点回调地址（题目容器 → 后端 8080）。
# 默认 host.docker.internal 即可：DockerDriver 以 --add-host host-gateway 注入解析，
# Linux（部署目标）与 Docker Desktop（本地体验）均开箱即用；
# 仅当宿主防火墙拦截容器→宿主 8080 时改为宿主 LAN IP。
ACADEMY_PUBLIC_URL=http://host.docker.internal:8080

# 实例驱动（可选）：auto（默认，启动时探测 docker CLI，可用即 docker，否则
# noop——实验环境接口 501）/ docker / noop。compose 已按部署约定显式设 docker
# （docs/architecture.md §9：容器化部署于 Linux 宿主）。
# ACADEMY_ENV_DRIVER=auto

# 前端对外端口（宿主侧），默认 8081
ACADEMY_WEB_PORT=8081

# 题目容器资源限额（可选；compose 已设容器内默认值）
# ACADEMY_INSTANCE_MEMORY=512m
# ACADEMY_INSTANCE_CPUS=0.5

# 落盘目录（可选；compose 已统一指向 /data 下的持久化卷，
# 覆盖前确认路径在 ./data 卷内，否则容器重建会丢头像/WP 附件）
# ACADEMY_AVATARS_DIR=/data/avatars
# ACADEMY_WRITEUPS_DIR=/data/writeups
