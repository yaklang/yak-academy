# docker compose 环境变量样例：复制为仓库根目录 .env 后按需修改。
# .env 已被 .gitignore 忽略，不会提交密钥。

# 必填：JWT 签名密钥（随机长字符串）
ACADEMY_JWT_SECRET=change-me-to-a-long-random-string

# 必填：初始管理员密码（users 表为空时首次启动创建）
ACADEMY_ADMIN_USERNAME=admin
ACADEMY_ADMIN_PASSWORD=change-me

# 题目容器检测点回调地址（题目容器 → 后端 8080）。
# 默认 host.docker.internal 即可：DockerDriver 以 --add-host host-gateway 注入解析，
# Linux（部署目标）与 Docker Desktop（本地体验）均开箱即用；
# 仅当宿主防火墙拦截容器→宿主 8080 时改为宿主 LAN IP。
ACADEMY_PUBLIC_URL=http://host.docker.internal:8080

# 实例驱动（可选）：auto（默认，启动时探测 docker CLI，可用即 docker，否则
# noop——实验环境接口 501）/ docker / noop。compose 已按部署约定显式设 docker
#（docs/architecture.md §9：容器化部署于 Linux 宿主）。
# ACADEMY_ENV_DRIVER=auto

# 数据层切换（可选，Phase 4 多人规模路线第一步）：PostgreSQL 连接串，
# 设置即切 PostgreSQL（方言兼容已覆盖迁移与派生表路径，集成测试回归）；
# 不设 = 默认 SQLite（compose 内为 /data/academy.db）。全新库语义：
# SQLite 存量数据不自动迁移（迁移工具后续阶段提供）。
# ACADEMY_DB_DSN=postgres://academy:secret@db-host:5432/academy?sslmode=disable

# 前端对外端口（宿主侧），默认 8081
ACADEMY_WEB_PORT=8081

# 题目容器资源限额（可选；compose 已设容器内默认值）
# ACADEMY_INSTANCE_MEMORY=512m
# ACADEMY_INSTANCE_CPUS=0.5

# 落盘目录（可选；compose 已统一指向 /data 下的持久化卷，
# 覆盖前确认路径在 ./data 卷内，否则容器重建会丢头像/WP 附件）
# ACADEMY_AVATARS_DIR=/data/avatars
# ACADEMY_WRITEUPS_DIR=/data/writeups

# 竞赛 WP zip 附件存储（可选，两选一）：
# 1) fs（默认）：ACADEMY_WRITEUPS_DIR 本地目录（compose 已指向 /data/writeups）；
# 2) s3：S3 兼容对象存储（MinIO / AWS S3 等），五个 _S3_* 参数配齐即切换；
#    endpoint 带 scheme（https://minio.corp:9000），http:// 前缀走明文；
#    PREFIX 为对象键前缀（多环境共用一桶时隔离用），可空。
# ACADEMY_WRITEUPS_STORE=s3
# ACADEMY_WRITEUPS_S3_ENDPOINT=https://minio.corp:9000
# ACADEMY_WRITEUPS_S3_BUCKET=academy-writeups
# ACADEMY_WRITEUPS_S3_ACCESS_KEY=...
# ACADEMY_WRITEUPS_S3_SECRET_KEY=...
# ACADEMY_WRITEUPS_S3_REGION=us-east-1
# ACADEMY_WRITEUPS_S3_PREFIX=

# 生产严格模式（建议生产恒开）：启动即校验凭据——JWT secret ≥32 字符且非
# 内置开发默认值、初始管理员密码 ≥12 字符且非内置默认值，不达标拒绝启动
# （compose 的 :? 只保证变量存在，拦不住显式设置的弱值/默认值）。
# ACADEMY_STRICT=1

# 备份（可选，ops 硬化）：周期备份间隔（time.ParseDuration 格式如 6h；不设 =
# 关闭周期备份，仅管理端「备份管理」页手动触发）与保留份数（超出自动清理）。
# 每份归档 = SQLite 一致性快照 + 附件/头像/WP 数据目录的 tar.gz，落
# /data/backups（随数据卷持久化）。注意：数据卷整卷损坏时备份同失，请定期
# 在管理端下载归档离机保存；PostgreSQL 模式（ACADEMY_DB_DSN）应用内备份
# 不支持，数据库走外部 pg_dump。
# ACADEMY_BACKUP_INTERVAL=6h
# ACADEMY_BACKUP_KEEP=7

# ACM 判题引擎（可选，两选一，都不配 = 引擎未装配，code 题判 internal_error）：
# 1) ACADEMY_YAK_BIN 显式指定容器内 yak 二进制路径；
# 2) 不配 env，管理端「题目管理 → ACM」状态卡点「从 OSS 下载引擎」——
#    二进制（约 220MB）从 yaklang 官方 OSS 异步下载到 ACADEMY_YAK_DIR
#    （默认 SQLite 数据库所在目录，容器内即 /data），完成即装配无需重启，
#    重启时自动探测该目录下的 yak 复用（下载一次即可）。
# ACADEMY_YAK_BIN=/data/yak
# ACADEMY_YAK_DIR=/data
